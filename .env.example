# Production defaults: Supabase credentials.
# Public values may be exposed to the browser. Never expose SUPABASE_SECRET_KEY.
NEXT_PUBLIC_ACCOUNT_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server-side aliases for Vercel Runtime Environment Variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional local Floci backend. Use only on your computer.
# BACKEND_MODE=floci
# AWS_ENDPOINT_URL=http://127.0.0.1:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# FATURA_BUCKET=fatura-local-documents
# FATURA_TABLE=fatura-local
