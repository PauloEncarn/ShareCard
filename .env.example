# Backend experimental local. Nunca exponha o Floci à internet.
BACKEND_MODE=floci
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
FATURA_BUCKET=fatura-local-documents
FATURA_TABLE=fatura-local

# Supabase production settings. Copy them from Project Settings > API.
# The publishable key can be used in the browser; service role must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ACCOUNT_BACKEND=supabase
NEXT_PUBLIC_ACCOUNT_BACKEND=supabase
