{
  "name": "fatura-em-dia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "node scripts/copy-worker.mjs",
    "backend:init": "node --env-file=.env.local --import tsx scripts/backend-init.ts",
    "backend:smoke": "tsx scripts/backend-smoke.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1128.0",
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/lib-dynamodb": "^3.1128.0",
    "@supabase/supabase-js": "^2.116.0",
    "iconoir-react": "^7.12.1",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "react-server-dom-webpack": "^19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "type": "module"
}
