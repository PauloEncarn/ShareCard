{
    "name": "fatura-em-dia",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.19.0",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "next dev --hostname 127.0.0.1",
        "build": "next build",
        "start": "next start --hostname 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts",
        "postinstall": "node scripts/copy-worker.mjs",
        "backend:init": "node --env-file=.env.local --import tsx scripts/backend-init.ts",
        "backend:smoke": "tsx scripts/backend-smoke.ts"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.1128.0",
        "@aws-sdk/client-s3": "^3.1128.0",
        "@aws-sdk/lib-dynamodb": "^3.1128.0",
        "@supabase/supabase-js": "^2.116.0",
        "iconoir-react": "^7.12.1",
        "next": "16.3.4",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "6.3.289",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@types/node": "22.20.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "tsx": "4.23.13",
        "typescript": "7.0.2"
    }
}
